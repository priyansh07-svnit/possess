def ofrenda_remembrance_from_daemon(lang):
    resp = socket_request({"type": "ofrenda", "lang": lang}, timeout=8.0)
    if resp and resp.get("whisper"):
        return resp["whisper"]
    return None


def local_ofrenda_remembrance(lang):
    # Tender fallback based on generic session memory (daemon may be down).
    if lang == "es":
        return (
            "Aqui reposan los comandos que ya no corren, los que murieron en el intento. "
            "Que descansen en paz, pequeno espiritu de la maquina."
        )
    return (
        "Here rest the commands that no longer run, the ones that died trying. "
        "Rest in peace, little commands. The ghost remembers."
    )


def cmd_ofrenda(args):
    lang = DEFAULT_LANG
    i = 0
    while i < len(args):
        if args[i] == "--lang" and i + 1 < len(args):
            lang = args[i + 1]
            i += 2
        elif args[i].startswith("--lang="):
            lang = args[i].split("=", 1)[1]
            i += 1
        else:
            i += 1
    if lang not in ("en", "es"):
        lang = "en"
    print(OFRENDA_ASCII)
    text = ofrenda_remembrance_from_daemon(lang)
    if not text:
        text = local_ofrenda_remembrance(lang)
    print(text)
    return 0


def cmd_send(args):
    # Internal: fire-and-forget a shell event to the daemon.
    if len(args) < 1:
        return 2
    try:
        event = json.loads(args[0])
    except Exception:
        return 2
    socket_send_fire_forget(event)
    return 0


def main(argv=None):
    argv = argv if argv is not None else sys.argv[1:]
    if not argv:
        print(__doc__)
        return 0
    cmd = argv[0]
    rest = argv[1:]
    if cmd == "on":
        return cmd_on(rest)
    if cmd == "off":
        return cmd_off(rest)
    if cmd == "status":
        return cmd_status(rest)
    if cmd == "haunt":
        return cmd_haunt(rest)
    if cmd == "ofrenda":
        return cmd_ofrenda(rest)
    if cmd == "send":
        return cmd_send(rest)
    print(f"possess: unknown command '{cmd}'", file=sys.stderr)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
